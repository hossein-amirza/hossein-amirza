
---
layout: null
---
{
  "stories": [
    {% for item in site.stories %}
    {
      "title": {{ item.title | jsonify }},
      "category": {{ item.category | default: "داستانک" | jsonify }},
      "excerpt": {{ item.excerpt | strip_html | strip_newlines | jsonify }},
      "text": {{ item.content | strip_html | strip_newlines | jsonify }},
      "source": "دفتر داستانک‌ها",
      "link": {{ item.url | relative_url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
